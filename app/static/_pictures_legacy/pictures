# app/routers/files.py
from fastapi import APIRouter, UploadFile, File, HTTPException, Request, status
from pathlib import Path
from uuid import uuid4
import shutil
import imghdr

router = APIRouter(prefix="/files", tags=["Files"])

# 저장 루트: app/static/pictures
PICTURES_DIR = Path("app/static/pictures")

# 허용 확장자/타입
ALLOWED_MIME = {"image/jpeg", "image/png", "image/webp", "image/gif"}
ALLOWED_EXT = {".jpg", ".jpeg", ".png", ".webp", ".gif"}

@router.post("/profile-image", status_code=status.HTTP_201_CREATED)
async def upload_profile_image(request: Request, file: UploadFile = File(...)):
    # 1) MIME 가드
    if file.content_type not in ALLOWED_MIME:
        raise HTTPException(status.HTTP_400_BAD_REQUEST, "이미지 파일만 업로드 가능합니다")

    # 2) 저장 폴더 준비 (YYYY/MM/ 형태로 쪼개고 싶다면 아래처럼)
    # from datetime import datetime
    # today = datetime.utcnow()
    # target_dir = PICTURES_DIR / f"{today:%Y}" / f"{today:%m}"
    target_dir = PICTURES_DIR  # 단일 폴더 사용
    target_dir.mkdir(parents=True, exist_ok=True)

    # 3) 파일명 생성
    suffix = Path(file.filename).suffix.lower()
    if suffix not in ALLOWED_EXT:
        # 확장자가 없거나 특이하면 MIME 기반으로 강제 부여
        if file.content_type == "image/jpeg": suffix = ".jpg"
        elif file.content_type == "image/png": suffix = ".png"
        elif file.content_type == "image/webp": suffix = ".webp"
        elif file.content_type == "image/gif": suffix = ".gif"
        else: suffix = ".img"

    name = f"{uuid4().hex}{suffix}"
    abs_path = target_dir / name

    # 4) 저장
    try:
        with abs_path.open("wb") as buf:
            shutil.copyfileobj(file.file, buf)
    finally:
        await file.close()

    # 5) 진짜 이미지인지 1차 확인 (간단 검증)
    try:
        kind = imghdr.what(abs_path)
        if kind is None:
            abs_path.unlink(missing_ok=True)
            raise HTTPException(status.HTTP_400_BAD_REQUEST, "손상되었거나 이미지가 아닙니다")
    except Exception:
        abs_path.unlink(missing_ok=True)
        raise

    # 6) URL 반환 (정적 마운트 기준)
    url_path = f"/static/pictures/{name}"
    absolute_url = str(request.base_url).rstrip("/") + url_path
    return {"url": url_path, "absolute_url": absolute_url}
