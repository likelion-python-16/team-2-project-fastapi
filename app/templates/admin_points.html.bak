<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>포인트 관리 - 관리자</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="/static/assets/final/css/styles.css" rel="stylesheet">
  <style>
    :root{--card-bg:#fff;--muted:#777;--br:#eee;--primary:#007bff;--success:#28a745;--warning:#ffc107;--danger:#dc3545}
    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Noto Sans KR,Apple SD Gothic Neo,Helvetica,Arial,sans-serif;margin:16px}
    .panel{border:1px solid var(--br);border-radius:12px;padding:20px;margin:12px 0;background:#fff}
    .muted{color:var(--muted);font-size:13px}
    .w-100{width:100%}
    .btn{padding:8px 16px;border:1px solid #ddd;border-radius:6px;background:#fff;cursor:pointer;font-size:13px;margin-right:8px}
    .btn:hover{background:#f7f7f7}
    .btn-primary{background:var(--primary);color:white;border-color:var(--primary)}
    .btn-primary:hover{background:#0056b3}
    .btn-success{background:var(--success);color:white;border-color:var(--success)}
    .btn-success:hover{background:#218838}
    .btn-danger{background:var(--danger);color:white;border-color:var(--danger)}
    .btn-danger:hover{background:#c82333}
    table{width:100%;border-collapse:collapse;margin-top:16px;font-size:13px}
    th,td{border-top:1px solid var(--br);padding:10px;vertical-align:top}
    th{background:#f8f9fa;text-align:left;font-weight:600}
    .ok{color:var(--success)}.err{color:var(--danger)}.warning{color:#856404}
    .row-flex{display:flex;gap:12px;align-items:center}
    .tiny{font-size:11px}
    .stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:24px}
    .stat-card{background:#f8f9fa;border:1px solid #e9ecef;border-radius:8px;padding:16px;text-align:center}
    .stat-label{font-size:12px;color:#6c757d;margin-bottom:4px}
    .stat-value{font-size:24px;font-weight:700;color:#333}
    .form-group{margin-bottom:16px}
    .form-label{display:block;margin-bottom:6px;font-weight:600}
    .form-control{width:100%;padding:8px;border:1px solid #ddd;border-radius:4px;font-size:13px}
    .status-badge{padding:3px 8px;border-radius:10px;font-size:11px;font-weight:500}
    .status-pending{background:#fff3cd;color:#856404;border:1px solid #ffeaa7}
    .status-reviewing{background:#cce5f0;color:#004085;border:1px solid #b3d7f0}
    .status-approved{background:#d4edda;color:#155724;border:1px solid #c3e6cb}
    .status-completed{background:#d1ecf1;color:#0c5460;border:1px solid #bee5eb}
    .status-rejected{background:#f8d7da;color:#721c24;border:1px solid #f5c6cb}
    .status-cancelled{background:#e2e3e5;color:#383d41;border:1px solid #d6d8db}
    .modal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.5)}
    .modal-content{background:#fff;margin:3% auto;padding:20px;width:90%;max-width:700px;border-radius:8px}
    .modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
    .modal-title{font-size:16px;font-weight:600}
    .close{font-size:20px;cursor:pointer;color:#aaa}
    .close:hover{color:#000}
    .tabs{display:flex;border-bottom:1px solid #ddd;margin-bottom:20px}
    .tab{padding:10px 20px;cursor:pointer;border-bottom:2px solid transparent}
    .tab.active{border-bottom-color:var(--primary);color:var(--primary);font-weight:600}
    .tab-content{display:none}
    .tab-content.active{display:block}
  </style>
</head>
<body>
  <div class="container">
    <h2>🔧 포인트 관리 - 관리자</h2>
    
    <!-- 탭 네비게이션 -->
    <div class="tabs">
      <div class="tab active" onclick="showTab('withdrawals')">💸 환급 신청 관리</div>
      <div class="tab" onclick="showTab('rewards')">🏆 챌린지 보상 관리</div>
    </div>

    <!-- 환급 신청 관리 탭 -->
    <div id="withdrawals" class="tab-content active">
      <!-- 통계 -->
      <div class="panel">
        <h3>📊 환급 현황</h3>
        <div class="stats-row">
          <div class="stat-card">
            <div class="stat-label">⏳ 대기 중인 환급</div>
            <div class="stat-value" id="pendingCount">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">✅ 오늘 처리됨</div>
            <div class="stat-value" id="todayProcessed">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">💰 총 신청 금액</div>
            <div class="stat-value" id="totalAmount">0원</div>
          </div>
        </div>
      </div>

      <!-- 대기 중인 환급 신청 -->
      <div class="panel">
        <div class="row-flex" style="margin-bottom:12px;">
          <h3>⏳ 대기 중인 환급 신청</h3>
          <button class="btn tiny" onclick="loadPendingWithdrawals()" style="margin-left:auto;">새로고침</button>
        </div>
        <div id="pendingWithdrawals">
          <div class="muted" style="text-align:center; padding:20px;">
            📄 데이터를 불러오는 중...
          </div>
        </div>
      </div>
    </div>

    <!-- 챌린지 보상 관리 탭 -->
    <div id="rewards" class="tab-content">
      <div class="panel">
        <h3>🏆 챌린지 보상 분배</h3>
        <div class="muted" style="margin-bottom:16px;">
          완료된 챌린지의 참가비를 완주자들에게 포인트로 분배합니다.
        </div>
        
        <div class="form-group">
          <label class="form-label">📋 챌린지 ID</label>
          <div style="display:flex; gap:8px; align-items:center;">
            <input type="number" class="form-control" id="challengeId" placeholder="챌린지 ID 입력" style="width: 200px;">
            <button class="btn btn-primary" onclick="loadChallengeRewardInfo()">
              🔍 보상 정보 조회
            </button>
          </div>
        </div>
        
        <div id="challengeRewardInfo" style="display: none;">
          <!-- 챌린지 보상 정보가 여기에 표시됩니다 -->
        </div>
      </div>
    </div>
  </div>

  <!-- 환급 신청 상세 모달 -->
  <div id="withdrawalModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">환급 신청 처리</h3>
        <span class="close" onclick="closeModal()">&times;</span>
      </div>
      <div id="withdrawalModalContent">
        <!-- 모달 내용이 여기에 로드됩니다 -->
      </div>
    </div>
  </div>

  <script>
    let currentWithdrawal = null;

    // 탭 전환
    function showTab(tabName) {
      // 모든 탭과 내용 비활성화
      document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      
      // 선택된 탭과 내용 활성화
      document.querySelector(`.tab[onclick="showTab('${tabName}')"]`).classList.add('active');
      document.getElementById(tabName).classList.add('active');
      
      // 해당 탭 데이터 로드
      if (tabName === 'withdrawals') {
        loadPendingWithdrawals();
      }
    }

    // 대기 중인 환급 신청 로드
    async function loadPendingWithdrawals() {
      try {
        const response = await fetch('/api/v1/points/admin/withdrawals/pending', {
          headers: {
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          }
        });
        
        const withdrawals = await response.json();
        const container = document.getElementById('pendingWithdrawals');
        
        if (withdrawals.length === 0) {
          container.innerHTML = '<p class="muted">대기 중인 환급 신청이 없습니다.</p>';
          return;
        }
        
        // 통계 업데이트
        document.getElementById('pendingCount').textContent = withdrawals.length;
        const totalAmount = withdrawals.reduce((sum, w) => sum + w.withdrawal_amount, 0);
        document.getElementById('totalAmount').textContent = totalAmount.toLocaleString() + '원';
        
        let html = '<table><thead><tr><th>신청일</th><th>사용자</th><th>포인트</th><th>환급금액</th><th>방법</th><th>계좌정보</th><th>액션</th></tr></thead><tbody>';
        
        withdrawals.forEach(w => {
          const accountInfo = w.method === 'bank_transfer' ? 
            `${w.bank_name}<br>${w.account_number}<br>${w.account_holder}` : 
            w.method;
            
          html += `
            <tr>
              <td>${new Date(w.requested_at).toLocaleDateString('ko-KR')}</td>
              <td>${w.username}<br><small class="muted">${w.user_name}</small></td>
              <td>${w.point_amount.toLocaleString()}P</td>
              <td>${w.withdrawal_amount.toLocaleString()}원<br><small class="muted">수수료: ${w.fee_amount.toLocaleString()}원</small></td>
              <td>${getMethodText(w.method)}</td>
              <td style="font-size: 11px;">${accountInfo}</td>
              <td>
                <button class="btn btn-success tiny" onclick="showWithdrawalDetail(${w.id})">처리</button>
              </td>
            </tr>
          `;
        });
        
        html += '</tbody></table>';
        container.innerHTML = html;
      } catch (error) {
        console.error('Error loading pending withdrawals:', error);
        document.getElementById('pendingWithdrawals').innerHTML = '<p class="err">데이터를 불러오는데 실패했습니다.</p>';
      }
    }

    // 환급 신청 상세 보기 및 처리
    async function showWithdrawalDetail(withdrawalId) {
      try {
        const response = await fetch(`/api/v1/points/admin/withdrawals/pending`, {
          headers: {
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          }
        });
        
        const withdrawals = await response.json();
        currentWithdrawal = withdrawals.find(w => w.id === withdrawalId);
        
        if (!currentWithdrawal) {
          alert('환급 신청을 찾을 수 없습니다.');
          return;
        }
        
        displayWithdrawalModal(currentWithdrawal);
        document.getElementById('withdrawalModal').style.display = 'block';
      } catch (error) {
        console.error('Error:', error);
        alert('환급 신청 정보를 불러오는데 실패했습니다.');
      }
    }

    // 환급 신청 모달 표시
    function displayWithdrawalModal(withdrawal) {
      const container = document.getElementById('withdrawalModalContent');
      
      let accountInfo = '';
      if (withdrawal.method === 'bank_transfer') {
        accountInfo = `
          <div class="form-group">
            <strong>은행명:</strong> ${withdrawal.bank_name}<br>
            <strong>계좌번호:</strong> ${withdrawal.account_number}<br>
            <strong>예금주:</strong> ${withdrawal.account_holder}
          </div>
        `;
      }
      
      const html = `
        <div class="form-group">
          <strong>신청 ID:</strong> ${withdrawal.id}<br>
          <strong>사용자:</strong> ${withdrawal.username} (${withdrawal.user_name})<br>
          <strong>신청일:</strong> ${new Date(withdrawal.requested_at).toLocaleDateString('ko-KR')}<br>
          <strong>포인트:</strong> ${withdrawal.point_amount.toLocaleString()}P<br>
          <strong>수수료:</strong> ${withdrawal.fee_amount.toLocaleString()}원<br>
          <strong>환급 금액:</strong> ${withdrawal.withdrawal_amount.toLocaleString()}원<br>
          <strong>환급 방법:</strong> ${getMethodText(withdrawal.method)}
        </div>
        ${accountInfo}
        
        <div class="form-group">
          <label class="form-label">관리자 메모</label>
          <textarea class="form-control" id="adminMemo" rows="3" placeholder="처리 메모를 입력하세요"></textarea>
        </div>
        
        <div class="form-group" id="rejectionReasonGroup" style="display: none;">
          <label class="form-label">거부 사유</label>
          <textarea class="form-control" id="rejectionReason" rows="3" placeholder="거부 사유를 입력하세요"></textarea>
        </div>
        
        <div class="form-group">
          <button class="btn btn-success" onclick="approveWithdrawal()">승인</button>
          <button class="btn btn-danger" onclick="showRejectionForm()">거부</button>
          <button class="btn" onclick="closeModal()">취소</button>
        </div>
        
        <div id="rejectionButtons" style="display: none; margin-top: 10px;">
          <button class="btn btn-danger" onclick="rejectWithdrawal()">거부 확인</button>
          <button class="btn" onclick="hideRejectionForm()">거부 취소</button>
        </div>
      `;
      
      container.innerHTML = html;
    }

    // 거부 폼 표시
    function showRejectionForm() {
      document.getElementById('rejectionReasonGroup').style.display = 'block';
      document.getElementById('rejectionButtons').style.display = 'block';
    }

    // 거부 폼 숨김
    function hideRejectionForm() {
      document.getElementById('rejectionReasonGroup').style.display = 'none';
      document.getElementById('rejectionButtons').style.display = 'none';
      document.getElementById('rejectionReason').value = '';
    }

    // 환급 승인
    async function approveWithdrawal() {
      if (!currentWithdrawal) return;
      
      const memo = document.getElementById('adminMemo').value;
      
      try {
        const response = await fetch(`/api/v1/points/admin/withdrawals/${currentWithdrawal.id}/approve`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          },
          body: JSON.stringify({ memo: memo })
        });
        
        const result = await response.json();
        
        if (response.ok) {
          alert(result.message);
          closeModal();
          loadPendingWithdrawals();
        } else {
          alert(result.detail || '승인에 실패했습니다.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('승인 처리 중 오류가 발생했습니다.');
      }
    }

    // 환급 거부
    async function rejectWithdrawal() {
      if (!currentWithdrawal) return;
      
      const reason = document.getElementById('rejectionReason').value;
      const memo = document.getElementById('adminMemo').value;
      
      if (!reason.trim()) {
        alert('거부 사유를 입력해주세요.');
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/points/admin/withdrawals/${currentWithdrawal.id}/reject`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          },
          body: JSON.stringify({ reason: reason, memo: memo })
        });
        
        const result = await response.json();
        
        if (response.ok) {
          alert(result.message);
          closeModal();
          loadPendingWithdrawals();
        } else {
          alert(result.detail || '거부에 실패했습니다.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('거부 처리 중 오류가 발생했습니다.');
      }
    }

    // 챌린지 보상 정보 로드
    async function loadChallengeRewardInfo() {
      const challengeId = document.getElementById('challengeId').value;
      
      if (!challengeId) {
        alert('챌린지 ID를 입력해주세요.');
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/points/admin/challenges/${challengeId}/reward-info`, {
          headers: {
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          }
        });
        
        const info = await response.json();
        
        if (response.ok) {
          displayChallengeRewardInfo(info);
        } else {
          alert(info.detail || '챌린지 정보를 불러올 수 없습니다.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('챌린지 정보를 불러오는데 실패했습니다.');
      }
    }

    // 챌린지 보상 정보 표시
    function displayChallengeRewardInfo(info) {
      const container = document.getElementById('challengeRewardInfo');
      
      const html = `
        <div class="stats-row">
          <div class="stat-card">
            <div class="stat-label">총 참가자</div>
            <div class="stat-value">${info.total_participants}명</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">완주자</div>
            <div class="stat-value">${info.completers_count}명</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">완주율</div>
            <div class="stat-value">${info.completion_rate}%</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">총 참가비</div>
            <div class="stat-value">${info.total_entry_fees.toLocaleString()}원</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">1인당 보상</div>
            <div class="stat-value">${info.expected_reward_per_person.toLocaleString()}P</div>
          </div>
        </div>
        
        <div class="panel">
          <h3>${info.challenge_title}</h3>
          <p><strong>상태:</strong> ${info.challenge_status}</p>
          ${info.challenge_status === 'completed' ? 
            '<button class="btn btn-primary" onclick="distributeRewards()">보상 분배 실행</button>' : 
            '<p class="muted">완료된 챌린지만 보상 분배가 가능합니다.</p>'
          }
        </div>
      `;
      
      container.innerHTML = html;
      container.style.display = 'block';
    }

    // 보상 분배 실행
    async function distributeRewards() {
      const challengeId = document.getElementById('challengeId').value;
      
      if (!confirm('정말로 보상을 분배하시겠습니까? 이 작업은 되돌릴 수 없습니다.')) {
        return;
      }
      
      try {
        const response = await fetch(`/api/v1/points/admin/challenges/${challengeId}/distribute-rewards`, {
          method: 'POST',
          headers: {
            'Authorization': 'Bearer ' + localStorage.getItem('access_token')
          }
        });
        
        const result = await response.json();
        
        if (response.ok) {
          alert(`${result.message}\n완주자: ${result.completers}명\n총 분배액: ${result.total_distributed.toLocaleString()}포인트`);
          loadChallengeRewardInfo(); // 정보 새로고침
        } else {
          alert(result.detail || '보상 분배에 실패했습니다.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('보상 분배 중 오류가 발생했습니다.');
      }
    }

    // 모달 닫기
    function closeModal() {
      document.getElementById('withdrawalModal').style.display = 'none';
      currentWithdrawal = null;
    }

    // 유틸리티 함수
    function getMethodText(method) {
      const methodMap = {
        bank_transfer: '계좌이체',
        toss_pay: '토스페이',
        kakao_pay: '카카오페이'
      };
      return methodMap[method] || method;
    }

    // 페이지 로드 시 초기화
    document.addEventListener('DOMContentLoaded', function() {
      loadPendingWithdrawals();
    });

    // 모달 외부 클릭 시 닫기
    window.onclick = function(event) {
      const modal = document.getElementById('withdrawalModal');
      if (event.target === modal) {
        closeModal();
      }
    };
  </script>
</body>
</html>