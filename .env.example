# ===========================================
# 🌍 환경 설정
# ===========================================
ENVIRONMENT=development
# 옵션: development, production, testing

# ===========================================
# 🔐 보안 설정
# ===========================================
# JWT 토큰 암호화 키 (32자 이상 권장)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Fernet 암호화 키 (44자 base64 인코딩된 키)
# Python에서 생성: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FERNET_KEY=your-fernet-key-here-44-chars-base64-encoded

# ===========================================
# 🗄️ 데이터베이스 설정
# ===========================================
# Docker Compose에서 오버라이드되므로 로컬 개발에서는 무시됨
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=team_user
MYSQL_PASSWORD=team_password_123
MYSQL_DATABASE=team_project_db
MYSQL_ROOT_PASSWORD=root_password_123

# ===========================================
# ☁️ AWS 설정
# ===========================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=your-s3-bucket-name

# ===========================================
# 🚀 API 서버 설정
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ===========================================
# 🌐 CORS 설정 (선택사항)
# ===========================================
# 추가 허용 도메인이 있다면 config.py에서 수정
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===========================================
# 📝 기타 설정
# ===========================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# JWT 토큰 만료 시간 (분)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30